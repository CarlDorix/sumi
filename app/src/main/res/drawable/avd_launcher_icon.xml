<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash icon: the brush stroke draws itself, then the seal dot pops in.
  Referenced from the splash theme as windowSplashScreenAnimatedIcon.
  The 108-unit viewport matches the adaptive icon; only the FOREGROUND art
  belongs here (the splash background comes from windowSplashScreenBackground),
  and the art stays inside the 66dp safe circle.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground_animated">

    <target android:name="brush">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType"
                android:duration="620"
                android:startOffset="80"
                android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>

    <target android:name="seal">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="300"
                    android:startOffset="640"
                    android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="300"
                    android:startOffset="640"
                    android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
